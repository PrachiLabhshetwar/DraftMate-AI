# Auto detect text files and perform LF normalization
* text=auto
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Legal Document Creator — Executive Edition</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- PDF.js for reading uploaded PDFs & html2pdf.js for exporting PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        :root {
            --active-accent: #38bdf8;
            --active-part: #0284c7;
            --active-bg: #0f1d3a;
        }

        * {
            box-sizing: border-box;
            user-select: none;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #070b14;
            color: #f8fafc;
        }

        #app {
            position: relative;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 70% 50%, #0f172a 0%, #060911 100%);
            transition: background 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* Subtle Luxury Ambient Noise/Grid Overlay */
        #app::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 32px 32px;
            pointer-events: none;
            z-index: 1;
        }

        /* --- TOP-RIGHT EXECUTIVE AI DROPDOWN & SOUND TOGGLE --- */
        .top-right-controls {
            position: absolute;
            top: 26px;
            right: 36px;
            z-index: 30;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sound-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.14);
            background: rgba(15, 23, 42, 0.65);
            color: #e2e8f0;
            backdrop-filter: blur(12px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
            cursor: pointer;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.25s ease;
        }

        .sound-btn:hover {
            border-color: rgba(255, 255, 255, 0.35);
            background: rgba(30, 41, 59, 0.85);
            transform: translateY(-1px);
        }

        .ai-dropdown {
            position: relative;
        }

        .ai-trigger-btn {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 30px;
            padding: 9px 18px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.4px;
            color: #f1f5f9;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
            transition: all 0.25s ease;
        }

        .ai-trigger-btn:hover {
            border-color: rgba(255, 255, 255, 0.35);
            background: rgba(30, 41, 59, 0.85);
        }

        .ai-dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 190px;
            background: rgba(13, 18, 30, 0.95);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 14px;
            padding: 6px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6);
            display: none;
            flex-direction: column;
            gap: 4px;
            transform-origin: top right;
            animation: fadeInMenu 0.18s ease-out;
        }

        @keyframes fadeInMenu {
            from { opacity: 0; transform: scale(0.95) translateY(-4px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .ai-dropdown-menu.show {
            display: flex;
        }

        .ai-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 9px 12px;
            border-radius: 9px;
            border: none;
            background: transparent;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 500;
            color: #cbd5e1;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s;
        }

        .ai-option:hover {
            background: rgba(255, 255, 255, 0.07);
            color: #fff;
        }

        .ai-option.active {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            font-weight: 600;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
        }
        .status-fast { background-color: #10b981; box-shadow: 0 0 8px #10b981; }
        .status-busy { background-color: #f59e0b; box-shadow: 0 0 8px #f59e0b; }

        /* --- VOLUMETRIC CONICAL SPOTLIGHT BEAM --- */
        .beam-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            pointer-events: none;
        }

        /* --- EXECUTIVE CENTER CONTENT INSIDE BEAM --- */
        .beam-content-wrapper {
            position: absolute;
            top: 50%;
            left: 55%;
            transform: translate(-50%, -50%);
            z-index: 5;
            width: 55vw;
            max-width: 680px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            transition: opacity 0.28s ease, transform 0.28s ease;
        }

        .suite-tag {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: #d4af37;
            margin-bottom: 10px;
            opacity: 0.9;
            transition: color 0.4s ease;
        }

        .doc-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.4rem, 3.8vw, 3.4rem);
            font-weight: 700;
            color: #f8fafc;
            margin: 0 0 24px 0;
            letter-spacing: 0.8px;
            line-height: 1.1;
            text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .create-now-btn {
            padding: 11px 28px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%);
            color: #090d16;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
            transition: all 0.3s ease;
        }

        .create-now-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.12);
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.6);
        }

        /* --- LEFT LUXURY SPINNING WHEEL --- */
        .wheel-container {
            position: absolute;
            left: -520px;
            top: 50%;
            transform: translateY(-50%);
            width: 840px;
            height: 840px;
            z-index: 10;
            cursor: grab;
        }

        .wheel-container:active {
            cursor: grabbing;
        }

        #wheel-svg {
            width: 100%;
            height: 100%;
            overflow: visible;
            filter: drop-shadow(18px 0px 40px rgba(0, 0, 0, 0.65));
        }

        .sector-path {
            stroke: rgba(255, 255, 255, 0.06);
            stroke-width: 1;
            transition: fill 0.4s ease, filter 0.3s ease;
            cursor: pointer;
        }

        .sector-group:hover .sector-path {
            filter: brightness(1.2);
        }

        .sector-code {
            font-size: 19px;
            font-weight: 700;
            letter-spacing: 1px;
            text-anchor: middle;
            dominant-baseline: central;
            pointer-events: none;
            transition: fill 0.3s ease;
        }

        .sector-sub {
            font-size: 9.5px;
            font-weight: 600;
            text-anchor: middle;
            dominant-baseline: central;
            pointer-events: none;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            opacity: 0.75;
            transition: fill 0.3s ease;
        }

        /* Drag Helper Hint */
        .drag-hint {
            position: absolute;
            bottom: 24px;
            left: 24px;
            z-index: 15;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 30px;
            font-weight: 500;
            font-size: 0.74rem;
            letter-spacing: 0.4px;
            color: #94a3b8;
            pointer-events: none;
        }

        /* ==============================================================
           SECOND PAGE: EXECUTIVE 3D FLIP SHEET WORKSPACE
           ============================================================== */
        .creator-page {
            position: fixed;
            inset: 0;
            z-index: 50;
            background: radial-gradient(circle at 50% 20%, var(--active-bg) 0%, #050811 85%);
            backdrop-filter: blur(22px);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 24px 40px;
            opacity: 0;
            pointer-events: none;
            transform: scale(1.04);
            transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1), transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
            overflow-y: auto;
        }

        .creator-page.open {
            opacity: 1;
            pointer-events: auto;
            transform: scale(1);
        }

        /* Workspace Top Header */
        .creator-header {
            width: 100%;
            max-width: 1060px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }

        .back-wheel-btn {
            background: rgba(15, 23, 42, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #e2e8f0;
            padding: 9px 18px;
            border-radius: 30px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.25s ease;
        }

        .back-wheel-btn:hover {
            border-color: var(--active-accent);
            background: rgba(30, 41, 59, 0.9);
            transform: translateX(-2px);
        }

        .creator-title-area {
            text-align: center;
        }

        .creator-title-area span {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            color: var(--active-accent);
            font-weight: 700;
            display: block;
        }

        .creator-title-area h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            margin: 2px 0 0 0;
            color: #ffffff;
        }

        /* API Key Box */
        .api-key-box {
            display: flex;
            align-items: center;
            background: rgba(10, 15, 28, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 30px;
            padding: 5px 14px;
            gap: 8px;
        }

        .api-key-box input {
            background: transparent;
            border: none;
            color: #f8fafc;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.76rem;
            width: 175px;
            outline: none;
            user-select: text;
        }

        .api-key-box input::placeholder {
            color: #64748b;
        }

        /* Mode Switcher Bar (Triggers 3D Axis Flip) */
        .mode-switch-bar {
            display: flex;
            background: rgba(10, 14, 24, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 40px;
            padding: 5px;
            gap: 6px;
            margin-bottom: 22px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
        }

        .mode-tab {
            padding: 10px 24px;
            border-radius: 30px;
            border: none;
            background: transparent;
            color: #94a3b8;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mode-tab.active {
            background: linear-gradient(135deg, var(--active-part) 0%, var(--active-bg) 100%);
            color: #ffffff;
            border: 1px solid var(--active-accent);
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
        }

        /* 3D FLIP STAGE & CARD */
        .sheet-stage {
            width: 100%;
            max-width: 780px;
            height: 450px;
            perspective: 1800px;
            position: relative;
            flex-shrink: 0;
        }

        .flip-sheet {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.85s cubic-bezier(0.34, 1.45, 0.64, 1);
        }

        .flip-sheet.flipped {
            transform: rotateY(180deg);
        }

        .sheet-face {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            background: linear-gradient(160deg, rgba(17, 25, 42, 0.96) 0%, rgba(8, 12, 22, 0.98) 100%);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-top: 2px solid var(--active-accent);
            border-radius: 22px;
            padding: 28px 34px;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.75);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-y: auto;
        }

        .sheet-back {
            transform: rotateY(180deg);
        }

        .sheet-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        .sheet-head h3 {
            margin: 0;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: #f8fafc;
            letter-spacing: 0.5px;
        }

        .sheet-badge {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            padding: 4px 12px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.06);
            color: var(--active-accent);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        /* Form Grid Inside Front Sheet */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 18px;
            margin-bottom: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        .form-group label {
            font-size: 0.74rem;
            font-weight: 600;
            color: #cbd5e1;
            letter-spacing: 0.4px;
        }

        .form-input {
            background: rgba(7, 11, 20, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 10px;
            padding: 10px 14px;
            color: #f8fafc;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.84rem;
            outline: none;
            user-select: text;
            transition: border-color 0.25s;
        }

        .form-input:focus {
            border-color: var(--active-accent);
        }

        textarea.form-input {
            resize: none;
            height: 68px;
        }

        /* File Upload Zone Inside Back Sheet */
        .upload-zone {
            border: 1.5px dashed rgba(255, 255, 255, 0.22);
            border-radius: 16px;
            background: rgba(7, 11, 20, 0.65);
            padding: 24px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
            margin-bottom: 14px;
        }

        .upload-zone:hover, .upload-zone.dragover {
            border-color: var(--active-accent);
            background: rgba(255, 255, 255, 0.04);
        }

        .upload-icon {
            font-size: 2rem;
            margin-bottom: 6px;
            display: block;
        }

        .upload-zone p {
            margin: 4px 0;
            font-size: 0.85rem;
            color: #e2e8f0;
            font-weight: 600;
        }

        .upload-zone small {
            font-size: 0.74rem;
            color: #94a3b8;
        }

        .file-pill {
            display: none;
            align-items: center;
            justify-content: space-between;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #34d399;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 0.78rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .sheet-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .flip-link-btn {
            background: transparent;
            border: none;
            color: #94a3b8;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: underline;
            transition: color 0.2s;
        }

        .flip-link-btn:hover {
            color: #ffffff;
        }

        /* --- GENERATED LEGAL DOCUMENT PREVIEW & EXPORT --- */
        .output-section {
            width: 100%;
            max-width: 780px;
            margin-top: 24px;
            display: none;
            flex-direction: column;
            gap: 16px;
            padding-bottom: 40px;
            animation: fadeInOutput 0.4s ease-out;
        }

        .output-section.visible {
            display: flex;
        }

        @keyframes fadeInOutput {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .paper-container {
            background: #fdfbf7;
            color: #0f172a;
            border-radius: 14px;
            padding: 42px 48px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);
            border: 1px solid #e2e8f0;
            font-family: 'Cormorant Garamond', Georgia, serif;
            line-height: 1.65;
            font-size: 1.08rem;
            user-select: text;
            height: auto;
            overflow: visible;
        }

        .paper-container h1, .paper-container h2, .paper-container h3 {
            font-family: 'Cormorant Garamond', serif;
            color: #090d16;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1.5px solid #cbd5e1;
            padding-bottom: 10px;
            margin-top: 0;
            font-size: 1.3rem;
        }

        .paper-content {
            white-space: pre-wrap;
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 1.1rem;
            color: #1e293b;
            outline: none;
        }

        .output-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.14);
            padding: 14px 22px;
            border-radius: 16px;
        }

        .export-pdf-btn {
            padding: 12px 28px;
            border-radius: 50px;
            border: 1px solid #34d399;
            background: linear-gradient(135deg, #059669 0%, #064e3b 100%);
            color: #ffffff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 25px rgba(5, 150, 105, 0.4);
            transition: all 0.25s ease;
        }

        .export-pdf-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.15);
        }
    </style>
</head>
<body>

    <div id="app">
        <!-- TOP RIGHT COMPACT AI DROPDOWN & SOUND BUTTON -->
        <div class="top-right-controls">
            <button class="sound-btn" id="sound-toggle" onclick="toggleSound()" title="Mute/Unmute Sound">🔊</button>
            
            <div class="ai-dropdown" id="ai-dropdown">
                <button class="ai-trigger-btn" onclick="toggleDropdown(event)">
                    <span class="status-dot status-fast" id="current-ai-dot"></span>
                    <span id="current-ai-name">Gemini 3.8</span>
                    <span style="font-size: 0.65rem; opacity: 0.6;">▼</span>
                </button>
                <div class="ai-dropdown-menu" id="ai-menu">
                    <button class="ai-option active" onclick="selectModel('Gemini 3.8', 'fast', this)">
                        <span>Gemini 3.8</span>
                        <span class="status-dot status-fast"></span>
                    </button>
                    <button class="ai-option" onclick="selectModel('Claude', 'fast', this)">
                        <span>Claude</span>
                        <span class="status-dot status-fast"></span>
                    </button>
                    <button class="ai-option" onclick="selectModel('ChatGPT', 'busy', this)">
                        <span>ChatGPT</span>
                        <span class="status-dot status-busy" title="High Traffic"></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- VOLUMETRIC SPOTLIGHT CONICAL BEAM -->
        <svg class="beam-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs>
                <linearGradient id="beam-grad" x1="15%" y1="50%" x2="100%" y2="50%">
                    <stop offset="0%" id="beam-stop-start" stop-color="#d4af37" stop-opacity="0.38" />
                    <stop offset="55%" id="beam-stop-mid" stop-color="#d4af37" stop-opacity="0.14" />
                    <stop offset="100%" id="beam-stop-end" stop-color="#d4af37" stop-opacity="0.02" />
                </linearGradient>
            </defs>
            <polygon id="beam-polygon" points="18,36 100,-8 100,108 18,64" fill="url(#beam-grad)" />
        </svg>

        <!-- LEFT LUXURY SPINNING WHEEL -->
        <div class="wheel-container" id="wheel-container">
            <svg id="wheel-svg" viewBox="-420 -420 840 840">
                <circle cx="0" cy="0" r="282" fill="#05080f" stroke="rgba(255,255,255,0.06)" stroke-width="2" />
                <g id="wheel-rotator"></g>
            </svg>
        </div>

        <!-- EXECUTIVE CENTER CONTENT -->
        <div class="beam-content-wrapper" id="beam-content">
            <div class="suite-tag" id="suite-tag">Legal Intelligence Suite</div>
            <h1 class="doc-title" id="main-title">Rent Agreement</h1>
            <button class="create-now-btn" id="create-btn" onclick="openDocCreator()">
                Create Now <span>→</span>
            </button>
