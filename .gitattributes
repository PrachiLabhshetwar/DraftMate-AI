        function closeDocCreator() {
            playClickSound();
            document.getElementById('creator-page').classList.remove('open');
        }

        function flipSheetTo(side, silent = false) {
            if (!silent) playFlipSound();
            const sheet = document.getElementById('flip-sheet');
            const tabDetails = document.getElementById('tab-details');
            const tabOldDoc = document.getElementById('tab-old-doc');

            if (side === 'back') {
                sheet.classList.add('flipped');
                tabOldDoc.classList.add('active');
                tabDetails.classList.remove('active');
            } else {
                sheet.classList.remove('flipped');
                tabDetails.classList.add('active');
                tabOldDoc.classList.remove('active');
            }
        }

        // --- File Upload (PDF / TXT) Reader ---
        async function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            playClickSound();

            const pill = document.getElementById('uploaded-file-pill');
            const nameSpan = document.getElementById('uploaded-file-name');
            pill.style.display = 'flex';
            nameSpan.innerText = `⏳ Reading ${file.name}...`;

            try {
                if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
                    const arrayBuffer = await file.arrayBuffer();
                    const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                    let textContent = '';
                    for (let i = 1; i <= pdf.numPages; i++) {
                        const page = await pdf.getPage(i);
                        const txt = await page.getTextContent();
                        textContent += txt.items.map(s => s.str).join(' ') + '\n\n';
                    }
                    extractedOldDocText = textContent.trim();
                } else {
                    extractedOldDocText = await file.text();
                }
                nameSpan.innerText = `✅ ${file.name} (${Math.max(1, Math.round(extractedOldDocText.length / 1000))}k chars extracted)`;
            } catch (err) {
                console.error(err);
                extractedOldDocText = `[Uploaded Reference File: ${file.name}]`;
                nameSpan.innerText = `✅ ${file.name} attached`;
            }
        }

        function clearUploadedFile() {
            playClickSound();
            extractedOldDocText = '';
            document.getElementById('old-doc-file').value = '';
            document.getElementById('uploaded-file-pill').style.display = 'none';
        }

        // --- AI API Call + Executive Fallback Generator ---
        async function generateDraft(mode) {
            playClickSound();
            const activeData = fullWheelItems[activeSegmentIndex];
            const apiKey = document.getElementById('user-api-key').value.trim();

            const btnId = mode === 'details' ? 'generate-from-details-btn' : 'generate-from-old-btn';
            const btn = document.getElementById(btnId);
            const originalBtnHTML = btn.innerHTML;
            btn.innerHTML = `⏳ Drafting with ${selectedAI}...`;
            btn.disabled = true;

            let promptContext = '';
            if (mode === 'details') {
                const p1 = document.getElementById('f_party1')?.value || 'First Party [Name]';
                const p2 = document.getElementById('f_party2')?.value || 'Second Party [Name]';
                const prop = document.getElementById('f_prop')?.value || 'Standard Subject Matter / Property';
                const amt = document.getElementById('f_amount')?.value || 'Mutually Agreed Consideration';
                const terms = document.getElementById('f_terms')?.value || 'Standard statutory legal clauses';

                promptContext = `Draft a formal, comprehensive Indian legal "${activeData.title}".\n` +
                    `- First Party: ${p1}\n- Second Party: ${p2}\n- Subject/Property/Forum: ${prop}\n` +
                    `- Consideration/Claim/Term: ${amt}\n- Specific Terms: ${terms}`;
            } else {
                const instructions = document.getElementById('redraft-instructions').value || 'Update dates, refine legal language, and modernize clauses.';
                const refText = extractedOldDocText ? extractedOldDocText.substring(0, 6000) : 'Standard Reference Template';
                promptContext = `Redraft and modernize this existing "${activeData.title}" based on the uploaded document.\n` +
                    `Modifications Requested: ${instructions}\n\nExisting Document Content:\n${refText}`;
            }

            let generatedText = '';

            // If user entered an API key, call live Gemini or OpenAI endpoint
            if (apiKey) {
                try {
                    if (apiKey.startsWith('AIza')) {
                        // Google Gemini API
                        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                contents: [{ parts: [{ text: `You are an elite Senior Legal Counsel. Write a complete, court-ready legal document without markdown asterisks:\n\n${promptContext}` }] }]
                            })
                        });
                        const data = await res.json();
                        generatedText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
                    } else {
                        // OpenAI ChatGPT Compatible API
                        const res = await fetch('https://api.openai.com/v1/chat/completions', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${apiKey}`
                            },
                            body: JSON.stringify({
                                model: 'gpt-4o-mini',
                                messages: [
                                    { role: 'system', content: 'You are an elite Senior Legal Counsel. Draft complete, formal, court-ready legal documents in plain text.' },
                                    { role: 'user', content: promptContext }
                                ]
                            })
                        });
                        const data = await res.json();
                        generatedText = data?.choices?.[0]?.message?.content || '';
                    }
                } catch (err) {
                    console.warn('API call failed, using Executive Legal Template fallback:', err);
                }
            }

            // High-precision Executive Legal Fallback if no API key or network error
            if (!generatedText) {
                await new Promise(r => setTimeout(r, 650));
                generatedText = buildExecutiveLegalDraft(activeData.title, mode);
            }

            document.getElementById('paper-heading').innerText = activeData.title.toUpperCase();
            document.getElementById('paper-body').innerText = generatedText;

            const outputSec = document.getElementById('output-section');
            outputSec.classList.add('visible');
            outputSec.scrollIntoView({ behavior: 'smooth', block: 'start' });

            btn.innerHTML = originalBtnHTML;
            btn.disabled = false;
            playSlideChime();
        }

        function buildExecutiveLegalDraft(docTitle, mode) {
            const today = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
            if (mode === 'old_doc') {
                const mod = document.getElementById('redraft-instructions').value || 'Updated for current statutory compliance';
                const snippet = extractedOldDocText
                    ? extractedOldDocText.substring(0, 500) + '...'
                    : 'Previous executed instrument on record.';
                return `THIS REDRAFTED & AMENDED ${docTitle.toUpperCase()} IS EXECUTED ON THIS ${today.toUpperCase()}\n\n` +
                    `[Redrafted via ${selectedAI} Legal Intelligence Engine]\n\n` +
                    `WHEREAS the parties previously executed a base instrument and now mutually desire to restate, amend, and supersede the prior terms with the following modifications:\n` +
                    `• Applied Amendments: ${mod}\n\n` +
                    `1. INCORPORATION & RESTATEMENT OF BASE CLAUSES\n` +
                    `The foundational recitals from the uploaded instrument are hereby restated:\n"${snippet}"\n\n` +
                    `2. OPERATIVE COVENANTS & STATUTORY COMPLIANCE\n` +
                    `All financial covenants, notice periods, indemnity obligations, and dispute resolution clauses stand updated in accordance with prevailing Indian Contract Act, 1872 and applicable laws in force in 2026.\n\n` +
                    `3. GOVERNING LAW & ARBITRATION\n` +
                    `Any dispute arising out of this restated instrument shall be referred to a Sole Arbitrator under the Arbitration and Conciliation Act, 1996.\n\n` +
                    `IN WITNESS WHEREOF, the Parties have set their hands on ${today}.\n\n` +
                    `__________________________                      __________________________\n` +
                    `FIRST PARTY SIGNATURE                           SECOND PARTY SIGNATURE`;
            }

            const p1 = document.getElementById('f_party1')?.value || '______________________';
            const p2 = document.getElementById('f_party2')?.value || '______________________';
            const prop = document.getElementById('f_prop')?.value || '______________________';
            const amt = document.getElementById('f_amount')?.value || '______________________';
            const terms = document.getElementById('f_terms')?.value || 'Standard statutory covenants applicable.';

            return `THIS ${docTitle.toUpperCase()} IS MADE AND EXECUTED ON THIS ${today.toUpperCase()}\n\n` +
                `BETWEEN:\n` +
                `1. ${p1}, hereinafter referred to as the "FIRST PARTY" (which expression shall unless repugnant to the context include its heirs, successors, and permitted assigns).\n\n` +
                `AND:\n` +
                `2. ${p2}, hereinafter referred to as the "SECOND PARTY" (which expression shall unless repugnant to the context include its heirs, successors, and permitted assigns).\n\n` +
                `WHEREAS:\n` +
                `A. Subject Matter / Property / Forum: ${prop}\n` +
                `B. Financial Consideration / Claim / Term: ${amt}\n\n` +
                `NOW THIS INSTRUMENT WITNESSETH AS FOLLOWS:\n\n` +
                `1. SCOPE & SPECIAL COVENANTS\n` +
                `${terms}\n\n` +
                `2. REPRESENTATIONS, INDEMNITY & OBLIGATIONS\n` +
                `Both Parties represent that they have full legal capacity and authority to execute this ${docTitle}. Each Party agrees to indemnify and hold harmless the other against any direct breach of the covenants herein.\n\n` +
                `3. TERMINATION & NOTICE\n` +
                `Either Party may exercise termination or statutory remedies by serving a formal written notice as stipulated above.\n\n` +
                `4. GOVERNING LAW & DISPUTE RESOLUTION\n` +
                `This instrument shall be governed by the laws of India. The local courts shall have exclusive jurisdiction.\n\n` +
                `IN WITNESS WHEREOF, the Parties hereto have signed this ${docTitle} on the day, month, and year first above written.\n\n\n` +
                `__________________________                      __________________________\n` +
                `FIRST PARTY (${p1})                             SECOND PARTY (${p2})\n\n` +
                `WITNESS 1: ________________                     WITNESS 2: ________________`;
        }

        // --- EXPORT AS PDF ---
        function exportDocumentAsPDF() {
            playClickSound();
            const element = document.getElementById('pdf-paper');
            const docTitle = fullWheelItems[activeSegmentIndex].title.replace(/\s+/g, '_');

            const opt = {
                margin: [12, 12, 12, 12],
                filename: `${docTitle}_Executive_Draft.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save();
        }

        function triggerSnorAI() {
            playSlideChime();
            openDocCreator();
        }

        renderWheel();
    </script>
