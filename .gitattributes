        // SECOND PAGE: 3D FLIP SHEET & AI DRAFTING FUNCTIONS
        // ==============================================================
        function openDocCreator() {
            playSlideChime();
            const activeData = fullWheelItems[activeSegmentIndex];

            document.getElementById('studio-doc-title').innerText = activeData.title;
