                fields: [
                    { id: 'f_party1', label: 'Document Title / Case Citation', placeholder: 'e.g., Share Purchase Agreement / Supreme Court Judgment' },
                    { id: 'f_party2', label: 'Primary Parties Involved', placeholder: 'e.g., Acquirer Corp & Target Startup' },
                    { id: 'f_prop', label: 'Focus Areas for Executive Summary', placeholder: 'e.g., Financial Liabilities, Lock-in, Termination Risks' },
                    { id: 'f_amount', label: 'Preferred Output Format', placeholder: 'e.g., Clause-by-Clause Breakdown + Red Flag Analysis' },
                    { id: 'f_terms', label: 'Paste Raw Legal Text / Clauses to Summarise', placeholder: 'Paste clauses or text here, or flip sheet to upload a full PDF/TXT file...', full: true }
                ]
            }
        ];

        const fullWheelItems = [...items, ...items];
        const totalSegments = fullWheelItems.length;
        const angleStep = 360 / totalSegments;
        const innerRadius = 285;
        const outerRadius = 410;

        const rotator = document.getElementById('wheel-rotator');
        const wheelContainer = document.getElementById('wheel-container');
        const app = document.getElementById('app');
        const stopStart = document.getElementById('beam-stop-start');
        const stopMid = document.getElementById('beam-stop-mid');
        const stopEnd = document.getElementById('beam-stop-end');
        const mainTitle = document.getElementById('main-title');
        const suiteTag = document.getElementById('suite-tag');
        const createBtn = document.getElementById('create-btn');
        const beamContent = document.getElementById('beam-content');

        let currentRotation = 0;
        let activeSegmentIndex = -1;
        let selectedAI = 'Gemini 3.8';
        let isInitialLoad = true;
        let extractedOldDocText = '';

        function createSectorPath(startAngleDeg, endAngleDeg, rIn, rOut) {
            const toRad = (deg) => (deg * Math.PI) / 180;
            const a1 = toRad(startAngleDeg);
            const a2 = toRad(endAngleDeg);

            const x1In = rIn * Math.cos(a1), y1In = rIn * Math.sin(a1);
            const x2Out = rOut * Math.cos(a1), y2Out = rOut * Math.sin(a1);
            const x3Out = rOut * Math.cos(a2), y3Out = rOut * Math.sin(a2);
            const x4In = rIn * Math.cos(a2), y4In = rIn * Math.sin(a2);

            return `M ${x1In} ${y1In} L ${x2Out} ${y2Out} A ${rOut} ${rOut} 0 0 1 ${x3Out} ${y3Out} L ${x4In} ${y4In} A ${rIn} ${rIn} 0 0 0 ${x1In} ${y1In} Z`;
        }

        const sectorGroups = fullWheelItems.map((item, index) => {
            const centerAngle = index * angleStep;
            const halfGap = 0.55;
            const startA = centerAngle - angleStep / 2 + halfGap;
            const endA = centerAngle + angleStep / 2 - halfGap;

            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            g.setAttribute('class', 'sector-group');

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('class', 'sector-path');
            path.setAttribute('d', createSectorPath(startA, endA, innerRadius, outerRadius));
            path.setAttribute('fill', item.partRest);

            const midRadius = (innerRadius + outerRadius) / 2;
            const rad = (centerAngle * Math.PI) / 180;
            const tx = midRadius * Math.cos(rad);
            const ty = midRadius * Math.sin(rad);

            const textGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            textGroup.setAttribute('data-x', tx);
            textGroup.setAttribute('data-y', ty);

            const codeText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            codeText.setAttribute('class', 'sector-code');
            codeText.setAttribute('y', '-6');
            codeText.textContent = item.code;

            const subText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            subText.setAttribute('class', 'sector-sub');
            subText.setAttribute('y', '12');
            subText.textContent = item.sub;

            textGroup.appendChild(codeText);
            textGroup.appendChild(subText);
            g.appendChild(path);
            g.appendChild(textGroup);

            g.addEventListener('click', () => {
                if (!hasDragged) snapToSegment(index);
            });

            rotator.appendChild(g);
            return { g, path, codeText, subText, textGroup, item, index };
        });

        function renderWheel() {
            rotator.setAttribute('transform', `rotate(${currentRotation})`);

            let closestIdx = 0;
            let minDiff = Infinity;

            sectorGroups.forEach(({ textGroup, index }) => {
                const baseAngle = index * angleStep;
                let netAngle = (baseAngle + currentRotation) % 360;
                if (netAngle > 180) netAngle -= 360;
                if (netAngle < -180) netAngle += 360;

                const diff = Math.abs(netAngle);
                if (diff < minDiff) {
                    minDiff = diff;
                    closestIdx = index;
                }

                const tx = textGroup.getAttribute('data-x');
                const ty = textGroup.getAttribute('data-y');
                textGroup.setAttribute('transform', `translate(${tx}, ${ty}) rotate(${-currentRotation})`);
            });

            if (closestIdx !== activeSegmentIndex) {
                setActiveSegment(closestIdx);
            }
        }

        function setActiveSegment(index) {
            activeSegmentIndex = index;
            const activeData = fullWheelItems[index];

            if (!isInitialLoad) {
                playWheelTick();
            }

            sectorGroups.forEach(({ path, codeText, subText, item }, i) => {
                const isActive = (i === index);
                path.setAttribute('fill', isActive ? item.partActive : item.partRest);
                codeText.setAttribute('fill', isActive ? '#ffffff' : '#94a3b8');
                subText.setAttribute('fill', isActive ? '#e2e8f0' : '#64748b');
            });

            app.style.background = `radial-gradient(circle at 65% 50%, ${activeData.bgInner} 0%, ${activeData.bgOuter} 100%)`;
            stopStart.setAttribute('stop-color', activeData.beamColor);
            stopMid.setAttribute('stop-color', activeData.beamColor);
            stopEnd.setAttribute('stop-color', activeData.beamColor);

            // Sync CSS variables with active wheel theme
            document.documentElement.style.setProperty('--active-accent', activeData.accent);
            document.documentElement.style.setProperty('--active-part', activeData.partActive);
            document.documentElement.style.setProperty('--active-bg', activeData.bgInner);

            suiteTag.style.color = activeData.accent;
            createBtn.style.background = `linear-gradient(135deg, ${activeData.partActive} 0%, ${activeData.bgInner} 100%)`;
            createBtn.style.color = activeData.btnText;
            createBtn.style.borderColor = activeData.accent;

            beamContent.style.opacity = '0.2';
            beamContent.style.transform = 'translate(-50%, -46%)';
            setTimeout(() => {
                mainTitle.innerText = activeData.title;
                beamContent.style.opacity = '1';
                beamContent.style.transform = 'translate(-50%, -50%)';
            }, 130);

            isInitialLoad = false;
        }

        function snapToSegment(index) {
            const targetBase = -index * angleStep;
            const diff = ((targetBase - currentRotation + 540) % 360) - 180;
            animateRotation(currentRotation + diff);
        }

        function animateRotation(target) {
            const start = currentRotation;
            const change = target - start;
            const duration = 260;
            let startTime = null;

            function step(timestamp) {
                if (!startTime) startTime = timestamp;
                const progress = Math.min((timestamp - startTime) / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 3);
                currentRotation = start + change * ease;
                renderWheel();
                if (progress < 1) {
                    requestAnimationFrame(step);
                } else {
                    playSlideChime();
                }
            }
            requestAnimationFrame(step);
        }

        // --- Drag & Scroll Controls (Disabled when Studio Page is open) ---
        let isDragging = false;
        let hasDragged = false;
        let startY = 0;
        let startRot = 0;

        wheelContainer.addEventListener('mousedown', (e) => {
            if (document.getElementById('creator-page').classList.contains('open')) return;
            initAudio();
            isDragging = true;
            hasDragged = false;
            startY = e.clientY;
            startRot = currentRotation;
        });

        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            const deltaY = e.clientY - startY;
            if (Math.abs(deltaY) > 4) hasDragged = true;
            currentRotation = startRot + deltaY * 0.35;
            renderWheel();
        });

        window.addEventListener('mouseup', () => {
            if (!isDragging) return;
            isDragging = false;
            const nearestIdx = Math.round(-currentRotation / angleStep);
            animateRotation(-nearestIdx * angleStep);
        });

        let scrollTimer;
        window.addEventListener('wheel', (e) => {
            if (document.getElementById('creator-page').classList.contains('open')) return;
            initAudio();
            currentRotation -= e.deltaY * 0.14;
            renderWheel();
            clearTimeout(scrollTimer);
            scrollTimer = setTimeout(() => {
                const nearestIdx = Math.round(-currentRotation / angleStep);
                animateRotation(-nearestIdx * angleStep);
            }, 120);
        });

        // --- AI Dropdown Logic ---
        function toggleDropdown(e) {
            e.stopPropagation();
            playClickSound();
